# Serves the built SPA and passes /api to the API, so the browser sees one origin and the session cookie stays
# first-party. API_URL is the API's address, set in the container's environment.
server {
    listen 8080;
    server_tokens off;
    root /usr/share/nginx/html;

    # The API sends its own security headers; the SPA's are added only to what nginx serves itself.
    location /api/ {
        proxy_pass ${API_URL};
        proxy_set_header Host $host;
        # Who is really calling, for the API's rate limit. The API believes these only when told to
        # (ASPNETCORE_FORWARDEDHEADERS_ENABLED=true); see the API's README.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
    }

    # Built files carry a hash of their content in their name, so they can be kept for good.
    location /assets/ {
        include /etc/nginx/security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # Every other address is a screen of the app. The page itself is checked for a new version each time.
    location / {
        include /etc/nginx/security-headers.conf;
        add_header Cache-Control "no-cache";
        try_files $uri /index.html;
    }
}
